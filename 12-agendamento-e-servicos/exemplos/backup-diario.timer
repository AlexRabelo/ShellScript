[Unit]
Description=Timer para backup diário às 02:30
Documentation=man:backup-diario.service(1)
Requires=backup-diario.service

[Timer]
# Executa diariamente às 02:30
OnCalendar=daily 02:30
# Se o sistema estava desligado no horário, executa assim que ligar
Persistent=true
# Adiciona aleatoriedade de até 15min para evitar thundering herd
RandomizedDelaySec=15min
# Precisão de 1 minuto (padrão: 1min)
AccuracySec=1min
# Descrição amigável
Description=Backup diário rotativo

[Install]
WantedBy=timers.target