[Unit]
Description=Backup diário migrado do cron (02:30)
Documentation=man:backup-rotativo.sh(1)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/sbin/backup-rotativo.sh
ConditionPathExists=/dados
ConditionPathExists=/backup

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backup-rotativo.sh -r 30 /dados /backup
User=backup
Group=backup
WorkingDirectory=/backup
# Segurança
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/backup /var/log/backup-rotativo.log
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Logs via journal (substitui >> /var/log/backup.log 2>&1)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backup-diario-migracao
# Timeout generoso para backup grande
TimeoutStartSec=7200
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target