[Unit]
Description=Timer para healthcheck periódico (a cada 5 minutos)
Documentation=man:healthcheck-periodico.service(1)
Requires=healthcheck-periodico.service

[Timer]
# Executa a cada 5 minutos (minuto 0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55)
OnCalendar=*:0/5
# Se sistema estava desligado, executa no boot
Persistent=true
# Jitter de até 30s para evitar thundering herd em frotas
RandomizedDelaySec=30s
# Precisão de 1 minuto
AccuracySec=1min
Description=Healthcheck periódico de serviços

[Install]
WantedBy=timers.target