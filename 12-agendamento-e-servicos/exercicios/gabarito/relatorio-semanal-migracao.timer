[Unit]
Description=Timer para relatório semanal migrado (segundas 06:00)
Documentation=man:relatorio-semanal-migracao.service(1)
Requires=relatorio-semanal-migracao.service

[Timer]
# Segundas às 06:00
OnCalendar=Mon 06:00
Persistent=true
RandomizedDelaySec=30min
AccuracySec=1min
Description=Relatório de saúde semanal migrado do cron

[Install]
WantedBy=timers.target