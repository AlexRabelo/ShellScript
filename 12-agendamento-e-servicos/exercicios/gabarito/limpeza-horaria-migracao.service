[Unit]
Description=Limpeza de logs horária migrada do cron
Documentation=man:limpa-logs.sh(1)
After=network-online.target
ConditionPathExists=/usr/local/sbin/limpa-logs.sh
ConditionPathExists=/var/log/app

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/limpa-logs.sh -d 7 /var/log/app
User=backup
Group=backup
# Segurança
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/app
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=limpeza-horaria-migracao
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target