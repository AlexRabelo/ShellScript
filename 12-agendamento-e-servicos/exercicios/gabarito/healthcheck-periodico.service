[Unit]
Description=Healthcheck periódico de serviços e endpoints
Documentation=man:healthcheck-servicos.sh(1)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/healthcheck-servicos.sh
ConditionPathExists=/etc/healthcheck/servicos.txt
ConditionPathExists=/etc/healthcheck/endpoints.txt

[Service]
Type=oneshot
ExecStart=/usr/local/bin/healthcheck-servicos.sh -j -s /etc/healthcheck/servicos.txt -e /etc/healthcheck/endpoints.txt
User=monitoring
Group=monitoring
# Segurança - Sandbox
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/healthcheck
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=healthcheck-periodico
# Timeout
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target