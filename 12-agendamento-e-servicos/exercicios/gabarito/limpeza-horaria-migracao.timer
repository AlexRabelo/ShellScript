[Unit]
Description=Timer para limpeza horária migrada (minuto 0)
Documentation=man:limpeza-horaria-migracao.service(1)
Requires=limpeza-horaria-migracao.service

[Timer]
# Hora em hora (minuto 0)
OnCalendar=hourly
Persistent=true
# Jitter 5min
RandomizedDelaySec=5min
AccuracySec=1min
Description=Limpeza de logs horária migrada do cron

[Install]
WantedBy=timers.target