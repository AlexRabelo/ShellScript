# sre-toolkit.conf - Arquivo de configuração padrão

# Diretórios
LOG_FILE=/var/log/sre-toolkit.log
# LOG_FILE=/tmp/sre-toolkit.log  # Para ambientes sem permissão em /var/log

# Alertas
# Slack
ALERT_SLACK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Teams
ALERT_TEAMS_URL=https://outlook.office.com/webhook/...
# Telegram
ALERT_TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
ALERT_TELEGRAM_CHAT_ID=987654321
# Webhook genérico
ALERT_WEBHOOK_URL=https://seu-sistema.com/webhook/alert
# Email (opcional)
ALERT_EMAIL_TO=seuequipe@exemplo.com
ALERT_EMAIL_FROM=sre-toolkit@seuservidor.com

# Configurações gerais
BACKUP_RETENCAO_DIAS=30
HEALTHCHECK_TIMEOUT=10
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default

# Níveis de log (0=desligado, 1=ligado)
LOG_LEVEL_INFO=1
LOG_LEVEL_AVISO=1
LOG_LEVEL_ERRO=1
LOG_LEVEL_DEBUG=0  # Apenas em desenvolvimento